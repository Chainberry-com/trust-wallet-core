root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
indent_size = 2
max_line_length = 140
ktlint_standard_no-wildcard-imports = disabled
# ChainSigning.kt je strukturno jedan fajl — file length nije issue
ktlint_standard_function-signature = disabled

[*.swift]
indent_size = 2

[*.gradle]
indent_size = 2
